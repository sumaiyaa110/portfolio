# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.
# Everything here is optional: the site builds and runs with none of them set.

# Public URL of the site, used for SEO links and the sitemap. On Vercel this is
# detected automatically; set it only if you use a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (https://resend.com, free tier). Without a key the form tells
# visitors to email you directly instead.
RESEND_API_KEY=
# Where contact messages are delivered. Defaults to the email in src/data/profile.ts.
CONTACT_TO_EMAIL=
# Sender address. Needs a domain verified in Resend; the default works for testing.
CONTACT_FROM_EMAIL=

# GitHub contribution calendar. Repositories and activity work without a token.
# Create a fine-grained token with no extra permissions (public data only).
GITHUB_TOKEN=
